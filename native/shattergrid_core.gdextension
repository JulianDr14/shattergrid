[configuration]

entry_symbol = "shattergrid_core_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]

macos.debug = "res://native/bin/libshattergrid_core.dylib"
macos.release = "res://native/bin/libshattergrid_core.dylib"
windows.debug.x86_64 = "res://native/bin/shattergrid_core.dll"
windows.release.x86_64 = "res://native/bin/shattergrid_core.dll"
