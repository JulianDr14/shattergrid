# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

*.gd text eol=lf
*.gdshader text eol=lf
*.glsl text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.py text eol=lf
*.md text eol=lf

*.vox binary
*.png binary
*.glb binary
